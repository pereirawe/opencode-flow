# .dockerignore — keep the opencode-flow image lean (issue #40)
# The build context is the config repo root (~/.config/opencode).

.git
.gitignore
node_modules
.opencode
.opencode/**
*.png
*.svg
*.jpg
*.jpeg
.vscode
**/__pycache__/**
**/*.pyc
package-lock.json
known_issues.md
resolved_issues.md
prioritization.md
scripts/tests/
VERSION

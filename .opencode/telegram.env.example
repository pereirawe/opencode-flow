# Telegram Bot — Notificações do opencode
# Copie este arquivo para telegram.env e preencha com as credenciais do seu bot.
#
# Para criar um bot:
#   1. Abra @BotFather no Telegram
#   2. Envie /newbot e siga as instruções
#   3. Copie o token gerado para TELEGRAM_BOT_TOKEN
#
# Para obter seu chat ID:
#   1. Envie qualquer mensagem para o bot
#   2. Acesse https://api.telegram.org/bot<TOKEN>/getUpdates
#   3. Copie o chat.id do resultado

TELEGRAM_BOT_TOKEN=<seu-bot-token-aqui>
TELEGRAM_CHAT_ID=<seu-chat-id-aqui>
